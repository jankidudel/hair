{
  "name": "hair",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "api",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:internal-links",
    "test:internal-links": "tsx --test scripts/**/*.test.ts",
    "check:internal-links": "tsx scripts/check-internal-links.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "tsx scripts/check-content.ts",
    "check:staged-content": "tsx scripts/check-staged-content.ts",
    "check:editorial-targets": "npm run check:editorial-targets --workspace=frontend",
    "check:generated-seo": "npm run check:generated-seo --workspace=frontend",
    "check:seo": "npm run check:seo --workspace=frontend",
    "seo:inventory": "tsx scripts/seo/generate-url-inventory.ts",
    "seo:validate": "tsx scripts/seo/validate.ts && npm run seo:inventory",
    "validate:prebuild": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run content:check && npm run check:editorial-targets",
    "verify": "npm run validate:prebuild && npm run build --workspace=frontend && npm run check:generated-seo && npm run check:internal-links",
    "infra:build": "npm run build --workspace=infra",
    "infra:diff:prod": "npm run diff:prod --workspace=infra",
    "precommit": "npm run lint && npm run content:check",
    "prepush": "npm run verify",
    "prepare": "npm run content:generate --workspace=frontend && npm run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks",
    "seo:audit": "tsx scripts/seo/audit-built-routes.ts",
    "seo:verify-production": "tsx scripts/seo/verify-production-routes.ts",
    "seo:smoke-release": "tsx scripts/seo/release-smoke.ts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
