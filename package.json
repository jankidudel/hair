{
  "name": "hair",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "api",
    "infra"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:internal-links",
    "test:internal-links": "tsx --test scripts/**/*.test.ts",
    "check:internal-links": "tsx scripts/check-internal-links.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:check": "tsx scripts/check-content.ts",
    "infra:build": "npm run build --workspace=infra",
    "infra:diff:dev": "npm run diff:dev --workspace=infra",
    "infra:diff:prod": "npm run diff:prod --workspace=infra",
    "precommit": "npm run format:check && npm run lint && npm run content:check",
    "prepush": "npm run lint && npm run test && npm run build && npm run content:check",
    "prepare": "npm run content:generate --workspace=frontend && npm run hooks:install",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
