{
  "name": "@hair/frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run content:generate && ng serve",
    "build": "npm run content:generate && npm run seo:generate && ng build && npm run assets:fingerprint",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "npm run content:generate && ng test --watch=false",
    "content:generate": "tsx scripts/generate-content.ts",
    "check:editorial-targets": "tsx scripts/check-editorial-targets.ts",
    "check:generated-seo": "tsx scripts/check-generated-seo.ts",
    "check:links": "tsx ../scripts/check-internal-links.ts",
    "report:product-freshness": "tsx scripts/report-product-freshness.ts",
    "report:us-localization": "tsx scripts/report-us-localization.ts",
    "check:seo": "npm run check:editorial-targets && npm run build && npm run check:generated-seo",
    "assets:fingerprint": "tsx scripts/fingerprint-static-assets.ts",
    "seo:generate": "tsx scripts/generate-seo.ts"
  },
  "dependencies": {
    "@angular/common": "20.3.30",
    "@angular/compiler": "20.3.30",
    "@angular/core": "20.3.30",
    "@angular/platform-browser": "20.3.30",
    "@angular/platform-server": "20.3.30",
    "@angular/router": "20.3.30",
    "@angular/ssr": "20.3.35",
    "gray-matter": "4.0.3",
    "rehype-parse": "9.0.1",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.35",
    "@angular/cli": "20.3.35",
    "@angular/compiler-cli": "20.3.30",
    "@eslint/js": "9.39.5",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "jsdom": "26.1.0",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.7"
  }
}
