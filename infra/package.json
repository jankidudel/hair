{
  "name": "@hair/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint bin lib test",
    "test": "tsx --test test/**/*.test.ts",
    "synth": "npm run build --workspace=@hair/api && cdk synth",
    "diff:prod": "npm run synth && cdk diff Hair-prod"
  },
  "dependencies": {
    "aws-cdk-lib": "2.277.0",
    "constructs": "10.8.1",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "aws-cdk": "2.1148.1",
    "eslint": "10.15.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
