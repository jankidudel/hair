{
  "name": "@hair/infra",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint bin lib test",
    "test": "tsx --test test/**/*.test.ts",
    "synth": "npm run build --workspace=@hair/api && cdk synth",
    "diff:dev": "npm run synth && cdk diff Hair-dev",
    "diff:prod": "npm run synth && cdk diff Hair-prod"
  },
  "dependencies": {
    "aws-cdk-lib": "2.267.0",
    "constructs": "10.8.1",
    "source-map-support": "0.5.21"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "aws-cdk": "2.1139.0",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  }
}
